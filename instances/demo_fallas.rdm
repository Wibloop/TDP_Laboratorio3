RDM_VERSION 5

# Demostracion de ecosistema global y fallas
# Nodos (NODE <id> <cap_nominal> <estado> <rho>)
NODE N1 100.0 OPERATIONAL 1.0
NODE N2 150.0 DEGRADED 0.5
NODE N3 200.0 OFFLINE 0.0

# Microservicios (agrupadores logicos)
MICROSERVICE M1
MICROSERVICE M2
MICROSERVICE M3

# Instancias (replicas desplegables)
