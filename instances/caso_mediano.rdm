RDM_VERSION 5

# Caso de prueba de tamano intermedio con topologia heterogenea
# Configuracion de infraestructura con nodos en distintos estados
NODE N1 200.0 OPERATIONAL 1.0
NODE N2 180.0 DEGRADED 0.75
NODE N3 150.0 OPERATIONAL 1.0
NODE N4 120.0 DEGRADED 0.5
NODE N5 100.0 OFFLINE 0.0

# Declaracion de microservicios
MICROSERVICE M1
MICROSERVICE M2
MICROSERVICE M3
MICROSERVICE M4

# Conjunto de replicas a desplegar
INSTANCE I1 M1 N1 35.0 12.0
INSTANCE I2 M1 N2 35.0 12.0
INSTANCE I3 M2 N1 40.0 15.0
INSTANCE I4 M2 N3 40.0 15.0
INSTANCE I5 M3 N2 20.0 8.0
INSTANCE I6 M3 N3 20.0 8.0
INSTANCE I7 M4 N1 15.0 5.0
INSTANCE I8 M4 N4 15.0 5.0
